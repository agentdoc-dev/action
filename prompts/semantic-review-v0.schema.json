{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "path_dispositions", "patch_candidates"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_ref",
          "classification",
          "headline",
          "code_evidence",
          "knowledge_evidence",
          "rationale",
          "proposal_expected"
        ],
        "properties": {
          "provider_ref": {"type": "string", "minLength": 1, "maxLength": 128},
          "classification": {
            "enum": [
              "consistent",
              "extends_existing_knowledge",
              "contradicts_existing_knowledge",
              "insufficient_evidence"
            ]
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n]+$"
          },
          "code_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "hunk_id", "old_range", "new_range", "hunk_sha256"],
              "properties": {
                "path": {"type": "string"},
                "hunk_id": {"type": "string"},
                "old_range": {"type": "string"},
                "new_range": {"type": "string"},
                "hunk_sha256": {"type": "string"}
              }
            }
          },
          "knowledge_evidence": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "content_hash"],
              "properties": {
                "id": {"type": "string"},
                "content_hash": {"type": "string"}
              }
            }
          },
          "rationale": {"type": "string", "maxLength": 1000},
          "proposal_expected": {"type": "boolean"}
        }
      }
    },
    "path_dispositions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "disposition", "finding_refs", "rationale"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "disposition": {
            "enum": [
              "covered_no_change",
              "create_knowledge",
              "update_knowledge",
              "no_durable_knowledge",
              "insufficient_evidence"
            ]
          },
          "finding_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "patch_candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {"enum": ["create", "update"]},
          "finding_ref": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"enum": ["claim", "decision", "api", "task"]},
          "target": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
          },
          "status": {"enum": ["draft", "proposed", "open"]},
          "body": {"type": "string", "minLength": 1, "maxLength": 16384},
          "fields": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_id"],
            "properties": {
              "page_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "after": {"type": "string", "maxLength": 128}
            }
          },
          "desired_status": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "oneOf": [
          {
            "required": [
              "operation",
              "finding_ref",
              "kind",
              "target",
              "status",
              "body",
              "fields",
              "placement"
            ],
            "properties": {"operation": {"const": "create"}}
          },
          {
            "required": ["operation", "finding_ref", "target"],
            "properties": {"operation": {"const": "update"}},
            "anyOf": [
              {"required": ["body"]},
              {"required": ["fields"]},
              {"required": ["desired_status"]}
            ]
          }
        ]
      }
    }
  }
}
